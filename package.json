{
  "name": "hyprland-mcp",
  "version": "0.1.0",
  "description": "MCP server for Hyprland desktop control — eyes and hands for agents, background-app testing included",
  "type": "module",
  "bin": {
    "hyprland-mcp": "./dist/hyprland-mcp"
  },
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/hyprland-mcp",
    "build:tsc": "tsc -p tsconfig.json",
    "start": "dist/hyprland-mcp",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "hyprland",
    "wayland",
    "computer-use"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "license": "MIT"
}
